<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style
        name="Theme.FLOW"
        parent="android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F6F8</item>
        <item name="android:navigationBarColor">#F4F6F8</item>
        <item name="android:windowActionModeOverlay">true</item>

    </style>

    <!--
        Android 12+ / AndroidX starting window.

        The system splash uses the same FLOW logo asset as the
        Compose splash. MainActivity then hands off immediately
        to FlowSplashScreen.
    -->
    <style
        name="Theme.FLOW.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#F4F8F6</item>

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/flow_logo
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.FLOW
        </item>

    </style>

</resources>
