# Development defaults. Never commit a real .env file.
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/flow
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_POOL_SIZE=10
JPA_DDL_AUTO=update
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
FLOW_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Android development can override the API URL with:
# ./gradlew -PFLOW_API_BASE_URL=http://10.0.2.2:8080/api/ assembleDebug
FLOW_BOOTSTRAP_ADMIN_USERNAME=
FLOW_BOOTSTRAP_ADMIN_PASSWORD=
